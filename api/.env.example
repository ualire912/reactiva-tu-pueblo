# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube a GitHub.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (BotFather) - los pone B2
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# IA (Google AI Studio) - los pone C1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL de la app en Vercel (sin barra final). En local: http://localhost:8100
FRONTEND_URL=

# Solo para el script demo_seed.py (en local, NO hace falta en Render)
# Contraseña de las cuentas de demo, mínimo 12 caracteres
DEMO_PASSWORD=
DEMO_FACEBOOK_PAGE_URL=
