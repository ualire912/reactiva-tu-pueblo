# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube a GitHub.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (BotFather) - los pone B2
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# IA (Google AI Studio) - los pone C1
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Varios separados por coma: si uno falla, prueba el siguiente
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# freellmpool es el proveedor principal de texto (gratis, sin clave). FREELLMPOOL=0 lo apaga.
FREELLMPOOL=1
# Opcionales: más proveedores gratuitos (texto y/o visión de carteles). Basta con uno.
NVIDIA_API_KEY=
NVIDIA_MODEL=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Extractor de carteles (extractor_vlm.py): orden de la cascada y modelos de visión
VLM_ORDEN=gemini,nvidia,mistral,groq,openrouter
GEMINI_VLM_MODEL=
NVIDIA_VLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
MISTRAL_VLM_MODEL=
GROQ_VLM_MODEL=
OPENROUTER_VLM_MODEL=

# Agente de eventos reales (scraper/agente_eventos.py): lee Facebook con Apify
# apify.com -> Settings -> API & Integrations. Sin él, el agente solo lee las noticias.
APIFY_TOKEN=

# URL de la app en Vercel (sin barra final). En local: http://localhost:8100
FRONTEND_URL=

# Solo para el script demo_seed.py (en local, NO hace falta en Render)
# Contraseña de las cuentas de demo, mínimo 12 caracteres
DEMO_PASSWORD=
DEMO_FACEBOOK_PAGE_URL=

# WhatsApp (Cloud API de Meta, modo de prueba): ver api/whatsapp.py
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=elige-una-palabra
WHATSAPP_APP_SECRET=
